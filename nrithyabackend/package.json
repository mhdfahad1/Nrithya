{
  "name": "nrithyabackend",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "https://github.com/bcast-dev-team/nrithyabackend.git",
  "author": "Vishnu S <vishnu@bluecast.tech>",
  "license": "MIT",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "clean-migrations": "rm -f src/migrations/*.ts",
    "start:prod": "npm run clean-migrations && npm run generate-migrations && npm run build && npm run migrate && npm run copy-assets && node dist/index.js",
    "start": "ts-node src/index.ts",
    "copy-assets": "copyfiles --all --up 1 --exclude \".//.{ts,tsx}\" \"./src//\" ./dist",
    "generate-migrations": "npx typeorm-ts-node-commonjs migration:generate ./src/migrations/test -d ./src/utils/data-source.ts",
    "migrate": "npx typeorm migration:run -d ./dist/utils/data-source.js",
    "revert": "npx typeorm-ts-node-esm migration:revert -d ./src/utils/data-source.ts",
    "drop": "npx typeorm-ts-node-esm schema:drop -d ./src/utils/data-source.ts",
    "prestart": "node sql.js"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/exceljs": "^1.3.0",
    "@types/jwt-simple": "^0.5.36",
    "@types/pg": "^8.11.2",
    "nodemon": "^3.1.9",
    "typescript": "^5.4.2"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.2.0",
    "@fastify/static": "^7.0.4",
    "@fastify/view": "^9.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "bcryptjs": "^2.4.3",
    "copyfiles": "^2.4.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fastify": "^4.26.2",
    "fastify-cron": "^1.3.1",
    "fastify-file-upload": "^4.0.0",
    "fastify-multer": "^2.0.3",
    "fs": "^0.0.1-security",
    "jsonwebtoken": "^9.0.2",
    "jwt-simple": "^0.5.6",
    "multer": "^1.4.5-lts.1",
    "path": "^0.12.7",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.20",
    "winston": "^3.12.0",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
